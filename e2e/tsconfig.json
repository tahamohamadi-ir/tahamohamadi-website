{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": {
            "@helpers/*": [
                "./tests/helpers/*"
            ]
        }
    },
    "include": [
        "tests/**/*.ts",
        "playwright.config.ts"
    ]
}