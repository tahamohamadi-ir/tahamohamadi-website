# Backend — Django + Gunicorn
# Python 3.12 slim base

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install system dependencies needed by psycopg and Pillow
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libpq-dev \
        libjpeg62-turbo-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Test image: includes backend test and lint dependencies. It is selected only
# by the `backend-test` Compose service, never by the production runtime.
FROM base AS test

COPY backend/requirements/base.txt backend/requirements/dev.txt ./requirements/
RUN pip install --no-cache-dir -r requirements/dev.txt

COPY backend/ .

CMD ["pytest"]

# Production image
FROM base AS production

COPY backend/requirements/prod.txt backend/requirements/base.txt ./requirements/
RUN pip install --no-cache-dir -r requirements/prod.txt

# Copy application code
COPY backend/ .

# Create media directory
RUN mkdir -p /app/media

EXPOSE 8000

CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "120"]
