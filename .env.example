# ═══════════════════════════════════════════════════════════════════════════════
# Environment Configuration — tahamohamadi-website
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in real values for your environment.
#   cp .env.example .env
#
# NEVER commit the actual .env file (it's in .gitignore).
# ═══════════════════════════════════════════════════════════════════════════════

# ─── General ──────────────────────────────────────────────────────────────────
# Which environment this deployment targets. Affects settings module selection
# and behavior (e.g., debug output, SSL enforcement).
# Values: dev | staging | prod
ENVIRONMENT=dev

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Used by the postgres Docker container AND Django's DATABASE_URL.
POSTGRES_DB=tahamohamadi
POSTGRES_USER=taha
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Django ───────────────────────────────────────────────────────────────────
# Generate a real key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-secret

# Which settings module to load. Options: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Enable/disable Django debug mode. MUST be False in production.
DJANGO_DEBUG=True

# Comma-separated list of hostnames Django will serve.
# In production, set to your actual domain(s).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Full database connection URL. Keep in sync with POSTGRES_* values above.
DATABASE_URL=postgres://taha:changeme@postgres:5432/tahamohamadi

# ─── Security — CORS & CSRF ──────────────────────────────────────────────────
# Comma-separated origins allowed to make cross-origin requests.
# In dev: http://localhost:3000 (Next.js dev server)
# In prod: https://tahamohamadi.ir,https://www.tahamohamadi.ir
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# Comma-separated origins trusted for CSRF (must include scheme).
# In prod: https://tahamohamadi.ir,https://www.tahamohamadi.ir
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost

# ─── Next.js ─────────────────────────────────────────────────────────────────
# Public URL exposed to the browser for client-side API requests (via Nginx).
NEXT_PUBLIC_API_URL=http://localhost/api

# Public site URL for canonical links, Open Graph, and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost

# Internal URL for SSR server-to-server calls (container-to-container, bypasses Nginx).
INTERNAL_API_URL=http://django:8000

# ─── Celery (task queue — configured in task 6.5) ────────────────────────────
# Broker URL for async tasks (workflow, notifications, scheduling).
# In production, point to a dedicated Redis or RabbitMQ instance.
CELERY_BROKER_URL=redis://redis:6379/0

# ─── Media ───────────────────────────────────────────────────────────────────
# Override the media storage path inside the Django container.
# Default: /app/media (when running in Docker)
DJANGO_MEDIA_ROOT=/app/media

# Public URL prefix for serving media files (served by Nginx in production).
MEDIA_URL=/media/

# ─── Nginx ───────────────────────────────────────────────────────────────────
# These are used by Nginx config templates (if templated) or for reference.
# In production, set to your actual domain.
# NGINX_SERVER_NAME=tahamohamadi.ir www.tahamohamadi.ir

# ─── Sentry (Error Tracking & Performance Monitoring) ─────────────────────────
# DSN from your Sentry project settings. Leave empty to disable.
# Used by both Django (backend) and Next.js (frontend).
SENTRY_DSN=

# Public DSN exposed to the browser for client-side error reporting.
# Usually the same value as SENTRY_DSN for Next.js projects.
NEXT_PUBLIC_SENTRY_DSN=

# Fraction of requests to capture for performance monitoring (0.0 – 1.0).
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Optional / Advanced ─────────────────────────────────────────────────────
# Django log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# DJANGO_LOG_LEVEL=INFO

# Database connection max age in seconds (connection pooling).
# DATABASE_CONN_MAX_AGE=60

# Django timezone (default: Asia/Tehran)
# DJANGO_TIME_ZONE=Asia/Tehran

# DRF page size
# API_PAGE_SIZE=20

# Enforce HTTPS redirect in production (default: True in prod settings)
# DJANGO_SECURE_SSL_REDIRECT=True

# Base URI for RFC 7807 Problem Details error type field
# PROBLEM_TYPE_BASE_URI=https://tahamohamadi.ir/problems
